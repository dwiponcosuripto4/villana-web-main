{
  "name": "villana-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed-data.ts",
    "db:import-geo": "npx tsx scripts/import-geo-data.ts",
    "db:reindex-search": "npx tsx scripts/populate-search-index.ts",
    "optimize-images": "npx tsx scripts/optimize-images.ts",
    "optimize-uploads": "npx tsx scripts/optimize-upload-images.ts",
    "relink-images": "npx tsx scripts/relink-optimized-images.ts",
    "gather-villas": "npx tsx scripts/gather-villas-from-maps.ts",
    "recalc-pvr-all": "npx tsx scripts/recalculate-all-pvr.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@inlang/paraglide-js": "^2.3.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@playwright/test": "^1.55.1",
    "@storybook/addon-a11y": "^9.1.12",
    "@storybook/addon-docs": "^9.1.12",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/addon-vitest": "^9.1.12",
    "@storybook/sveltekit": "^9.1.12",
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.18",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@vitest/browser": "^3.2.4",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "playwright": "^1.55.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^9.1.12",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^1.1.0",
    "@svelte-put/swipeable": "^1.1.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "^3.7.0",
    "@node-rs/argon2": "^2.0.2",
    "arctic": "^3.7.0",
    "bits-ui": "^2.14.4",
    "lucide-svelte": "^0.562.0",
    "marked": "^17.0.1",
    "moment": "^2.30.1",
    "postgres": "^3.4.7",
    "svelte-5-french-toast": "^2.0.6"
  }
}
