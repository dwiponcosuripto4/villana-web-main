DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Cloudflare Turnstile Configuration
# Get your keys from: https://dash.cloudflare.com/sign-up?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

UPLOADED_IMAGE_DIR="./static/uploads/villas"
IMAGE_OPTM_DIR="./static/images-optm/villas"
BACKUP_DIR="./backups/uploads"

GOOGLE_MAPS_API_KEY=AIxxxx

# Google OAuth Configuration
# Get your keys from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Image Optimizer: 'thumbor', 'imgproxy', or 'none' (default: none)
IMAGE_OPTIMIZER=none

# Thumbor Configuration (when IMAGE_OPTIMIZER=thumbor)
THUMBOR_URL=https://thumbor.yourdomain.com
THUMBOR_SECURITY_KEY=SECRET_KEY

# Imgproxy Configuration (when IMAGE_OPTIMIZER=imgproxy)
# Generate key/salt with: echo $(xxd -g 2 -l 64 -p /dev/random | tr -d '\n')
IMGPROXY_URL=https://imgproxy.yourdomain.com
IMGPROXY_KEY=your_hex_encoded_key
IMGPROXY_SALT=your_hex_encoded_salt

UPLOAD_DIR=static/uploads
PUBLIC_ASSET_BASE_URL=https://villana.localhost
